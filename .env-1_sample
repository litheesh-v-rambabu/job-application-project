# ============================================================
#  Job Application Automation Suite — Configuration
#  Developer: Litheesh V R | buffalo.edu
#  Fill in your keys below. Never share or commit this file.
# ============================================================

# --- Supabase (Database — online, always running) ---
# Get these from: supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- AI API Keys (free) ---
# Groq: console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_key_here
# Gemini: aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza_your_gemini_key_here
# Hunter.io: hunter.io → API → Your API Key
HUNTER_API_KEY=your_hunter_io_key_here
# Apollo.io: apollo.io → Settings → Integrations → API Key
APOLLO_API_KEY=your_apollo_io_key_here

# --- AI Models ---
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FAST_MODEL=llama3.1:8b

# --- Ollama local AI (runs on your M4) ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# --- n8n (Workflow Engine) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_SECURE_COOKIE=false

# --- Gmail Notifications ---
# Get App Password from: Google Account → Security → App Passwords
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Job Site API Keys (free — fill in after registration) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTIVE_API_KEY=
THE_MUSE_API_KEY=

# --- Project Paths ---
PROJECT_ROOT=~/Downloads/Job_Application_Project
COMPILED_RESUMES_DIR=~/Downloads/Job_Application_Project/compiled-resumes
LATEX_TEMPLATES_DIR=~/Downloads/Job_Application_Project/latex-templates

